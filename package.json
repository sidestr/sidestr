{
  "name": "sidestr",
  "version": "0.0.2",
  "description": "the sidestr client as one package: open a chain by its id, validate every block yourself, spend, peg in and out, use the EVM \u2014 in Node or a page",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": "github:sidestr/sidestr",
  "homepage": "https://sidestr.com",
  "exports": {
    ".": {
      "browser": "./browser.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "browser.mjs",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node test/package-test.mjs"
  },
  "dependencies": {
    "@bitcoin-desktop/schema": "github:bitcoin-desktop/schema#v0.0.27",
    "@sidestr/spec": "github:sidestr/spec#dbae14bfeab51f9a9f8c8a616616bfc1b35cc402",
    "@sidestr/explorer": "github:sidestr/explorer#66f54ae349fb6c96feb00b4e1d0a7b646c2d7510",
    "@sidestr/wallet": "github:sidestr/wallet#078faf760e99e87a83be99585b95029f54978d78"
  },
  "optionalDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3"
  }
}

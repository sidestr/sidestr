{
  "name": "sidestr",
  "version": "0.0.5",
  "description": "the sidestr client as one package: open a chain by its id, validate every block yourself, spend, peg in and out, use the EVM \u2014 in Node or a page",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": "github:sidestr/sidestr",
  "homepage": "https://sidestr.com",
  "exports": {
    ".": {
      "browser": "./browser.mjs",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "browser.mjs",
    "bin",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node test/package-test.mjs && node test/cli-test.mjs"
  },
  "dependencies": {
    "@bitcoin-desktop/schema": "github:bitcoin-desktop/schema#v0.0.27",
    "@sidestr/spec": "0.0.4",
    "@sidestr/explorer": "0.0.1",
    "@sidestr/wallet": "0.0.2"
  },
  "optionalDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3"
  },
  "bin": {
    "sidestr": "./bin/sidestr.mjs"
  }
}
